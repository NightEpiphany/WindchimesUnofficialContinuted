{
	"schemaVersion": 1,
	"id": "windchimes",
	"version": "${version}",
	"name": "Wind Chimes Rebuild",
	"description": "This mod adds three wind chimes that sway in the wind and occasionally ring. Designed to compliment the vanilla game, this mod has no settings that can be set.",
	"authors": [
		"hibiii",
		"NightEpiphany(moigferdsrte)"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/windchime-unofficial-continued",
		"sources": "https://github.com/NightEpiphany/WindchimesUnofficialContinuted/issues"
	},
	"license": "CC0-1.0",
	"icon": "assets/windchimes/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.moigferdsrte.windchimes.refine.Refine"
		],
		"client": [
			"com.moigferdsrte.windchimes.refine.RefineClient"
		]
	},
	"mixins": [
		"windchimes.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.16.9",
		"minecraft": "~1.21.10",
		"java": ">=21",
		"fabric-api": "*"
	}
}